  "feature_families": {
    "F1_dynamic_phenology": {
      "title": "Alineación Fenológica Dinámica por Fecha Pico (t_pico)",
      "features": [
        "f1_peak_biweek",
        "f1_pre_peak_vigor",
        "f1_peak_vigor",
        "f1_grainfill_vigor",
        "f1_senescence_drop",
        "f1_msi_at_grainfill"
      ],
      "rationale": "Alinea el calendario vegetativo respecto a la quincena de máximo dosel (t_pico) de cada parcela, separando siembras tempranas (mayo) de tardías (julio) y midiendo la caída de vigor y el estrés hídrico (MSI) exactamente durante el llenado de grano (+14 a +28 días post-espigamiento)."
    },
    "F2_physiology_stress_indices": {
      "title": "Índices Fisiológicos y de Estrés Hídrico/Sanitario Previamente Descartados",
      "features": [
        "f2_fapar_early",
        "f2_fapar_mid",
        "f2_lai_mid",
        "f2_savi_early",
        "f2_msi_grainfill",
        "f2_dswi4_early"
      ],
      "rationale": "Incorpora variables biofísicas directas que antes habían quedado fuera del pipeline: Fracción de Radiación Fotosintéticamente Activa Absorbida (FAPAR), Índice de Área Foliar (LAI), Índice Ajustado al Suelo (SAVI) y estrés hídrico/sanitario foliar (MSI, DSWI4)."
    },
    "F3_intra_parcel_damage_floor": {
      "title": "Heterogeneidad Intra-Parcela y Piso de Daño (_min, _std)",
      "features": [
        "f3_fapar_min_early",
        "f3_damage_floor_early",
        "f3_srndi_min_sepoct",
        "f3_evi_minratio_early"
      ],
      "rationale": "Captura siniestros parciales dentro del polígono (manchones por encharcamiento, helada temprana, acame o roya lineal) mediante los cuantiles mínimos (_min) y la relación min/promedio de FAPAR, ENDDI, NDDI y SRNDI."
    },
    "F4_presowing_tillage": {
      "title": "Labranza y Cobertura de Residuo Pre-Siembra (NDTI / STI)",
      "features": [
        "f4_tillage_ndti_std_early"
      ],
      "rationale": "Mide la uniformidad de preparación de cama de siembra y cobertura de rastrojo en abril-mayo mediante los índices de labranza de onda corta (NDTI y STI), altamente correlacionados con el vigor inicial en Puebla."
    },
    "F5_multiannual_788_latent": {
      "title": "Representación Auto-Supervisada sobre los 788 Ciclos Parcela × Año (2022–2025)",
      "features": [
        "f5_ndwi_q90_hist",
        "f5_pl_evi_q90_hist",
        "f5_pl_evi_anom_2025"
      ],
      "rationale": "Explota las 39,968 escenas satelitales a través de los 788 ciclos (197 parcelas × 4 años: 2022-2025) sin requerir etiquetas históricas, extrayendo la vocación hídrica/productiva intrínseca del suelo (cuantil 90 histórico) y la anomalía neta del ciclo 2025."
    }
  }
