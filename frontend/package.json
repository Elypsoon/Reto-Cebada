{
  "name": "agrocebada-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "media:sync": "node scripts/sync-media.mjs",
    "predev": "npm run media:sync",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run media:sync",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.15.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
